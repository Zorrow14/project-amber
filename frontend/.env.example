# Copy to .env.local for local overrides. Vite inlines VITE_* at build time.

# Where the Amber API lives. Unset, the app calls the local dev API on :8000.
# On Vercel set it to the Render URL, e.g. https://amber-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# The app's own origin, for the share card's absolute URLs (Open Graph, Twitter).
# Unset, it is https://amber-sim.vercel.app; set it for another domain.
# VITE_SITE_URL=https://amber-sim.vercel.app

# The landing view. Unset, it is About; "overview" restores the old landing page.
# VITE_DEFAULT_VIEW=about
