# Copy to .env and adjust. Every value here has a working default,
# so the data layer runs with no .env at all.

# Where the data tree lives. Override to build a panel outside the repo.
# AMBER_DATA_DIR=data

# Logging verbosity for pipeline runs: DEBUG, INFO, WARNING, ERROR.
AMBER_LOG_LEVEL=INFO

# --- API (phase 5) -----------------------------------------------------------
# Which tables the API serves: `release` (the committed data/release snapshot,
# the production default) or `processed` (your latest `make models` output).
AMBER_DATA_SOURCE=release

# Comma-separated origins allowed to call the API. Defaults to the Vite dev
# server; in production set the Vercel URL, e.g. https://amber.vercel.app
AMBER_CORS_ORIGINS=http://localhost:5173

# --- Not used yet -----------------------------------------------------------
# World Bank WDI needs no key, which is why the data layer has no secrets.
# ACLED (conflict intensity, phase 3+) does:
# ACLED_API_KEY=
# ACLED_EMAIL=
