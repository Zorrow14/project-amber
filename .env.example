# Copy to .env and adjust. Every value here has a working default,
# so the data layer runs with no .env at all.

# Where the data tree lives. Override to build a panel outside the repo.
# AMBER_DATA_DIR=data

# Logging verbosity for pipeline runs: DEBUG, INFO, WARNING, ERROR.
AMBER_LOG_LEVEL=INFO

# --- Not used yet -----------------------------------------------------------
# World Bank WDI needs no key, which is why the data layer has no secrets.
# ACLED (conflict intensity, phase 3+) does:
# ACLED_API_KEY=
# ACLED_EMAIL=
