# Data — regenerated by `make panel`, never committed.
# Raw pulls are a cache of the World Bank API; processed tables are derived.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
